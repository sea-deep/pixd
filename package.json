{
  "name": "pixd",
  "version": "1.0.0",
  "description": "A typed, template-based rewrite of the PixD Discord bot",
  "homepage": "https://github.com/sea-deep/pixd#readme",
  "bugs": {
    "url": "https://github.com/sea-deep/pixd/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sea-deep/pixd.git"
  },
  "author": "sea-deep",
  "license": "GPL-3.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "npm run build && node dist/index.js",
    "dev": "tsx --watch index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "railway up --detach --service pixd",
    "prepare": "git config core.hooksPath .hooks || true"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@google-cloud/vision": "^6.0.0",
    "@google/genai": "^2.21.0",
    "axios": "^1.20.0",
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0",
    "chess.js": "^1.0.0-beta.8",
    "colors": "^1.4.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "emoji-regex": "^10.3.0",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "google-translate-api-x": "^10.6.7",
    "googleapis": "^178.0.0",
    "groq-sdk": "^1.6.0",
    "mongodb": "^6.1.0",
    "mongoose": "^8.13.1",
    "openai": "^4.56.0",
    "opusscript": "^0.0.8",
    "p-queue": "^8.0.1",
    "sharp": "^0.35.4",
    "xml2js": "^0.6.2",
    "youtube-dl-exec": "^3.1.14",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^26.2.0",
    "@types/xml2js": "^0.4.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "youtube-dl-exec@3.1.14": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
}
